meta {
  name: Send Connection Request
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/connections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "addresseeId": "{{addresseeId}}"
  }
}

vars {
  addresseeId:
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("connectionId", res.body.id);
  }
}
