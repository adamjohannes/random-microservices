meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/accounts/login
  body: json
  auth: none
}

body:json {
  {
    "email": "adam@example.com",
    "password": "P@ssw0rd123!"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.access_token);
    bru.setVar("accountId", res.body.account.id);
  }
}
